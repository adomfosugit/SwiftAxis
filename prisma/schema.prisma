// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum JobStatus {
  FILE_SENT
  PROCESSING
  COMPLETE
  FLAGGED
  FILE_REUPLOADED
}


model Job {
  id String @id @default(cuid())

  // Clerk authenticated user ID
  clerkUserId String
  // Clerk authenticated Email
  userEmail   String

  status JobStatus @default(FILE_SENT)

  // Uploadcare / Cloudinary references
  jobUploadRef String

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Audit trail: every comment/flag left on this job
  comments Comment[]

  @@index([clerkUserId, status])
  @@index([clerkUserId, createdAt])
}

model Comment {
  id String @id @default(cuid())

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  // Clerk ID + email of the admin leaving the comment (denormalized so the
  // audit trail survives even if the admin account is later modified/removed)
  adminUserId String
  adminEmail  String

  comment String

  images CommentImage[]

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([adminUserId])
}

model CommentImage {
  id String @id @default(cuid())

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  // Full Uploadcare CDN URL, preloaded by admin before comment submission
  imageUrl String

  createdAt DateTime @default(now())

  @@index([commentId])
}
